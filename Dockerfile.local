# syntax=docker/dockerfile:1

# Imagen para ejecutar la aplicación en Linux, igual que hará Railway.
#
# Sirve para comprobar en tu propio equipo que la compilación de Linux funciona,
# sin esperar al despliegue:
#
#   docker compose up --build
#
# y abrir http://localhost:3100
#
# ── ¿Por qué se llama Dockerfile.local y no Dockerfile? ──────────────────────
# Railway construye SIEMPRE con un `Dockerfile` si lo encuentra en el
# repositorio. Como el despliegue con Railpack ya funciona, este archivo lleva
# otro nombre para no cambiarlo sin querer. Si algún día prefieres que Railway
# use esta imagen (build reproducible, versiones fijadas), renómbralo a
# `Dockerfile` y listo.

# ── Base ─────────────────────────────────────────────────────────────────────
FROM node:24-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ── Dependencias ─────────────────────────────────────────────────────────────
# Aquí SÍ se instalan las de desarrollo: hacen falta para compilar (TypeScript y
# Tailwind son dependencias de compilación).
FROM base AS dependencias
COPY package.json package-lock.json ./
RUN npm ci

# ── Compilación ──────────────────────────────────────────────────────────────
FROM base AS compilacion
COPY --from=dependencias /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ── Ejecución ────────────────────────────────────────────────────────────────
FROM base AS ejecucion
ENV NODE_ENV=production

# Solo las dependencias de ejecución. PGlite (la base de datos local) es de
# desarrollo: en producción se usa PostgreSQL, así que no se instala y la imagen
# pesa bastante menos.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=compilacion --chown=node:node /app/.next ./.next
COPY --from=compilacion --chown=node:node /app/public ./public
COPY --from=compilacion --chown=node:node /app/next.config.ts ./
COPY --from=compilacion --chown=node:node /app/tsconfig.json ./
# El arranque ejecuta `scripts/seed.ts`, que importa desde `src/`: hacen falta.
COPY --from=compilacion --chown=node:node /app/scripts ./scripts
COPY --from=compilacion --chown=node:node /app/src ./src

# No se ejecuta como root: el usuario `node` ya existe en la imagen oficial.
USER node

# Railway inyecta su propio PORT. En local se usa el 3000.
ENV PORT=3000
EXPOSE 3000

# `npm start` siembra los datos si la base está vacía y luego arranca Next.
CMD ["npm", "start"]
