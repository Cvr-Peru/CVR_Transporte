# Dependencias y artefactos de compilación
node_modules/
.next/
out/

# Base de datos local (se regenera con `npm run seed`)
data/

# Datos de calles para OSRM: ocupan 1-2 GB y se generan con
# `scripts/preparar-osrm.ps1`. No tienen sentido en el repositorio.
datos-osrm/

# Caché de npm usada en entornos con el sistema de archivos restringido
.npm-cache/

# Variables de entorno: nunca subir secretos al repositorio
.env
.env.local
.env.*.local

# Generado por Next.js
next-env.d.ts
*.tsbuildinfo

# Varios
*.log
.DS_Store
