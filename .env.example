# Copia este archivo como `.env` para configurar el entorno local.
# En Railway estas variables se definen en el panel del servicio.

# Zona horaria del servidor. IMPORTANTE en producción.
#
# La aplicación calcula «hoy» y todos los rangos de fechas con la hora local del
# proceso. Un contenedor en la nube suele estar en UTC, así que si la empresa
# opera en Perú (UTC-5), a partir de las 19:00 el sistema consideraría que ya
# es el día siguiente: los despachos del día, los indicadores y los vencimientos
# saldrían corridos.
#
# Por eso hay que fijar la zona de la empresa. En Railway, añade esta variable
# al servicio:
#   TZ=America/Lima
#
# Otras: America/Bogota, America/Mexico_City, America/Santiago, America/Argentina/Buenos_Aires
TZ=America/Lima

# Puerto del servidor.
#   `npm run dev` usa el 3100 de forma fija.
#   `npm start` respeta esta variable (por defecto, 3000).
#   En Railway lo define la plataforma automáticamente: no lo fijes allí.
PORT=3100

# Cadena de conexión a PostgreSQL.
#
# Si NO defines esta variable, la aplicación usa PGlite (PostgreSQL compilado a
# WebAssembly) y guarda los datos en `data/pgdata/`. Es lo cómodo para
# desarrollar: no hay que instalar ni arrancar ningún servidor.
#
# Si la defines, se conecta a un PostgreSQL real con el controlador `pg`.
# En Railway se configura como referencia al servicio de base de datos:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/transporte

# Carpeta donde PGlite guarda los datos (solo si no hay DATABASE_URL).
# PGLITE_DIR=./data/pgdata

# Número máximo de conexiones del pool de `pg`. 10 es un valor razonable.
# PGPOOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# Accesos de demostración
# ─────────────────────────────────────────────────────────────────────────────
# Con `1`, la pantalla de entrada muestra un botón por cada rol que entra
# directamente sin escribir contraseña. Es cómodo para enseñar el prototipo.
#
# PELIGROSO EN PRODUCCIÓN: cualquiera que abra la URL entraría como
# administrador. Quita esta variable en cuanto el sistema tenga datos reales.
#
# En un despliegue de producción NO se activa por defecto: hay que ponerla a 1
# a propósito, precisamente para que un descuido no deje el sistema abierto.
MOSTRAR_ACCESOS_DEMO=1
